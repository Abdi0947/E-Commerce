PORT=3001
NODE_ENV=production

# MySQL (use cPanel MySQL database credentials)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=24h

ADMIN_EMAIL=admin@ninamart.com
ADMIN_PASSWORD=change-me

# Your live storefront URL (no trailing slash)
FRONTEND_URL=http://ninamart.ethioperparation.com/

# Where files are stored on the server (absolute path recommended on cPanel)
# Example: /home/username/ninamart-api/uploads
# Or symlink to public_html: /home/username/public_html/uploads
UPLOADS_DIR=/home/ethiopti/ninamartback.ethioperparation.com/uploads

# URL path browsers use to load uploads (must match frontend VITE_UPLOADS_PUBLIC_URL)
# Recommended when only /api is proxied to Node:
UPLOADS_PUBLIC_URL=/api/files
# Alternative if Apache serves public_html/uploads directly:
# UPLOADS_PUBLIC_URL=/uploads
