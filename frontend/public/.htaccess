<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing files and folders (e.g. assets, optional /uploads copy)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # React SPA — all other routes to index.html
  RewriteRule ^ index.html [L]
</IfModule>
