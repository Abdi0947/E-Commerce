# Build with: npm run build
# Must match backend UPLOADS_PUBLIC_URL

# API base — use full URL on cPanel if fetch needs absolute backend URL:
# VITE_API_URL=https://ninamart.ethioperparation.com/api
VITE_API_URL=/api

# Uploads base — use FULL URL so <img> tags work everywhere (admin + storefront):
# VITE_UPLOADS_PUBLIC_URL=https://ninamart.ethioperparation.com/api/files
VITE_UPLOADS_PUBLIC_URL=/api/files
